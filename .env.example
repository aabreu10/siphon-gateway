# Siphon Gateway — Environment Configuration
# Copy this file to .env and adjust values as needed.

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=siphon
POSTGRES_PASSWORD=siphon_secret
POSTGRES_DB=siphon_gateway

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# The downstream URL where webhooks will be forwarded
TARGET_URL=http://host.docker.internal:9999/webhook

# Gateway
SERVER_PORT=8080
WORKER_CONCURRENCY=5
